# Editor / OS
.DS_Store
.idea/
.vscode/
# Local assets only (design mockups, sample CVs). Anchored to the repo root —
# a bare `data/` would also swallow source dirs like frontend/src/**/data/.
/data/

# The recruiter's process tracker: real candidate and client names. The
# importer and its tests read it from here when it is present and skip when it
# is not, so the file stays on the machines that need it and out of a history
# no erasure request can reach.
/docs/process_design/*.docx
.data/

DEPLOY.md
# Local editor/tool configs — machine-specific, often carry localhost ports
.codex/

# Credential files a provider hands you as a download. Google names its
# OAuth client secrets exactly like this, and they land in whatever folder
# the browser is pointed at — which on this repo was docs/, inside the
# working tree. GitHub's push protection caught one; this is the belt.
client_secret*.json
*service-account*.json

# Row backups an operator script writes before a destructive step. These hold
# real personal data — a note's full text names the manager it is about — so
# they are exactly what must never reach a commit. Push protection does not
# look for this: it scans for credentials, not for other people's data.
manager_notes_*.json
