# ---------------------------------------------------------------------------
# eligo-tech backend — example configuration.
# Copy to `.env` and adjust. The scaffold RUNS with these defaults and needs
# NO external services (SQLite fallback).
# ---------------------------------------------------------------------------

# App
ELIGO_APP_NAME="eligo-tech"
ELIGO_ENV=local
ELIGO_DEBUG=true

# Database
# Default: file-backed SQLite (async). Zero external dependencies.
ELIGO_DATABASE_URL="sqlite+aiosqlite:///./eligo.db"
#
# Supabase (managed Postgres) — the production system-of-record.
# Use the async driver prefix (postgresql+asyncpg), your project's Session
# Pooler host, and URL-encode the password. NEVER commit the real password —
# put it in .env (gitignored), not here.
#   ELIGO_DATABASE_URL="postgresql+asyncpg://postgres.dcolbtxcszgrikcznomd:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
#   ELIGO_DB_SSL=true
# (Transaction pooler on :6543 also works — the app disables statement caching for it.)
# ELIGO_DB_SSL=false

# CORS — frontend origins allowed to call the API (comma-separated or JSON list)
ELIGO_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Multi-tenancy — default tenant used by seed data / demo endpoints.
ELIGO_DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"

# Admission. A Clerk organization with no workspace gets 403; admit it with
#   python -m scripts.provision_tenant org_xxx "Display name"
# Set true only for an onboarding session — it lets ANY organization that signs
# in mint itself a workspace, which is what this replaced (ADR 0002 §1.2).
ELIGO_AUTO_PROVISION_TENANTS="false"

# LLM extraction (CV upload). Vendor-neutral: the factory selects an extractor
# by provider and always falls back to the heuristic parser if unavailable.
ELIGO_LLM_PROVIDER="openai"        # "openai" | "heuristic"
ELIGO_LLM_MODEL="gpt-4o-mini"
# The OpenAI extractor reads the STANDARD (unprefixed) OPENAI_API_KEY. Put the
# real key in .env (gitignored), never here. Absent → falls back to heuristic.
# OPENAI_API_KEY="sk-..."

# Matching/outreach LLM boundary is still stubbed (deterministic).

# Fernet key for credentials workspaces store for their own sources. Without
# it no source can be connected (passwords are never stored in the clear).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ELIGO_SECRET_KEY=

# With auth off every request is the default tenant. The app refuses to start
# that way against Postgres; set this only for a local database you own.
# ELIGO_ALLOW_INSECURE_NO_AUTH=false

# --- Outbound email (candidate Art. 14 notices / opt-in) -------------------
# Empty provider = this deployment CANNOT send; every send answers 503 rather
# than recording a notice nobody received. Resend needs a sender on a domain
# verified in its dashboard, or it refuses every message.
ELIGO_EMAIL_PROVIDER=""              # "" | "resend"
ELIGO_RESEND_API_KEY=""              # re_… — never commit the real key
ELIGO_EMAIL_FROM=""                  # "eligo-tech <no-reply@your-verified-domain.de>"
ELIGO_EMAIL_REPLY_TO=""              # a human mailbox a candidate can answer
# Origin the opt-in link points at. Must be the host serving /api/v1 (the
# backend), NOT the cockpit — the two opt-in routes are backend routes.
ELIGO_NOTICE_LINK_BASE_URL="https://monorepo-eligo-production.up.railway.app"
ELIGO_NOTICE_CONTROLLER_NAME="eligo-tech"               # who the notice says holds the data
ELIGO_NOTICE_CONTACT_EMAIL=""        # where a candidate exercises their rights
